Package: VetResearchLMM
Type: Package
Title: Linear Mixed Models: An Introduction with Applications in Veterinary
    Research
Version: 2.0.0
Date: 2026-11-10
Authors@R: c(
      person("Muhammad", "Yaseen", email = "myaseen208@gmail.com", role = c("aut", "cre"),
             comment = c(ORCID = "0000-0002-5923-1714"))
    , person("Luc", "Duchateau", email = "Luc.Duchateau@ugent.be", role = "ctb")
