\title{Example 1.3.2: expected mean squares in the fixed and the mixed model}
\description{
Drugs are given to whole herds and doses to animals within herds (\code{\link{ex124}}). With herd random, drug is
tested against herd within drug (Table 1.3.2.2); with one observation deleted the two expected mean squares no
longer match (Table 1.3.2.3: 9.7143 and 9.7222), so the F test is only approximate.
}
\examples{
# SAS program of the book (Appendix B):
#   proc glm data=ex124;
#     class herd dose drug;
#     model PCVdif = drug herd(drug) dose dose*drug;
#     random herd(drug) / test;
#   run;

em <-
  vlm_ems(
      fixed  = PCVdif ~ drug + drug:herd + dose + dose:drug
    , data   = ex124
    , random = ~ drug:herd
    , type   = 3
    , class  = "herd"
    )
em

# one observation deleted (Table 1.3.2.3)
em1 <-
  vlm_ems(
      fixed  = PCVdif ~ drug + drug:herd + dose + dose:drug
    , data   = ex124[-1, ]
    , random = ~ drug:herd
    , type   = 3
    , class  = "herd"
    )
em1$coefficients

# the mixed model analysis that replaces it
fm <-
  vlm_fit(
      fixed    = PCVdif ~ drug + dose + drug:dose
    , data     = ex124
    , random   = ~ drug:herd
    , repeated = NULL
    , method   = "REML"
    , ddfm     = "satterth"
    , type     = 3
    , class    = "herd"
    , bound    = TRUE
    , control  = list()
    )
fm$tests
}
