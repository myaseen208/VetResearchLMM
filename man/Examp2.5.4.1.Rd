\title{Example 2.5.4.1: broad and narrow inference spaces}
\description{
The mean of Samorin in \code{\link{ex125}}: its variance is 1.0975 when regions and herds are random (broad
space) and 0.175 for the six regions and herds of the study (narrow space), as in the fixed effects model.
}
\details{
The narrow-space estimate adds the random effects averaged over the observed levels (the part of an ESTIMATE
statement after the vertical bar in SAS); the fixed effects model with regions and herds fixed gives the same
standard error.
}
\examples{
# SAS program of the book (Appendix B):
#   proc mixed data=ex125;
#     class drug dose region;
#     model pcv = drug dose drug*dose / ddfm=satterth;
#     random region drug*region;
#     estimate 'Samorin mean' intercept 1 drug 0 1 dose 0.5 0.5 drug*dose 0 0 0.5 0.5;
#   run;
#   proc glm data=ex125;
#     class drug dose region;
#     model pcv = region drug drug*region dose drug*dose;
#     estimate 'Samorin mean' intercept 1 drug 0 1 dose 0.5 0.5 drug*dose 0 0 0.5 0.5;
#   run;

fm <-
  vlm_fit(
      fixed    = Pcv ~ Drug + dose + Drug:dose
    , data     = ex125
    , random   = ~ Region + Region:Drug
    , repeated = NULL
    , method   = "REML"
    , ddfm     = "satterth"
    , type     = 3
    , class    = NULL
    , bound    = TRUE
    , control  = list()
    )
vlm_estimate(
    fit    = fm
  , L      = list(
          "broad"  = list(Intercept = 1, Drug = c(0, 1),
                          dose = c(0.5, 0.5), "Drug:dose" = c(0, 0, 0.5, 0.5))
        , "narrow" = list(Intercept = 1, Drug = c(0, 1),
                          dose = c(0.5, 0.5), "Drug:dose" = c(0, 0, 0.5, 0.5))
        )
  , random = list(
          "narrow" = list(Region = rep(1 / 6, 6), "Region:Drug" = rep(c(0, 1 / 6), 6))
        )
  , level  = 0.95
  )

# the fixed effects model: regions and herds fixed
ff <-
  vlm_fit(
      fixed    = Pcv ~ Region + Drug + Region:Drug + dose + Drug:dose
    , data     = ex125
    , random   = NULL
    , repeated = NULL
    , method   = "REML"
    , ddfm     = "default"
    , type     = 3
    , class    = "Region"
    , bound    = TRUE
    , control  = list()
    )
vlm_estimate(
    fit    = ff
  , L      = list(
          "Samorin mean" = list(Intercept = 1, Region = rep(1 / 6, 6), Drug = c(0, 1),
                                "Region:Drug" = rep(c(0, 1 / 6), 6), dose = c(0.5, 0.5),
                                "Drug:dose" = c(0, 0, 0.5, 0.5))
        )
  , random = NULL
  , level  = 0.95
  )
}
