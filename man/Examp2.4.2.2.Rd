\title{Example 2.4.2.2: ML and REML estimates of variance components}
\description{
The split-plot data \code{\link{ex125}}: REML gives 5.151 (region), 0.387 (herd within region) and 2.096
(residual); ML gives the smaller 4.292, 0.322 and 1.747 (Table 2.4.2.1), because it ignores the degrees of
freedom used by the fixed effects. The Type 3 (moment) estimates equal REML here, as the data are balanced.
}
\examples{
# SAS program of the book (Appendix B):
#   proc mixed data=ex125 method=ml;   * and method=reml;
#     class drug dose region;
#     model pcv = drug dose drug*dose;
#     random region drug*region;
#   run;

ml <-
  vlm_fit(
      fixed    = Pcv ~ Drug + dose + Drug:dose
    , data     = ex125
    , random   = ~ Region + Region:Drug
    , repeated = NULL
    , method   = "ML"
    , ddfm     = "default"
    , type     = 3
    , class    = NULL
    , bound    = TRUE
    , control  = list()
    )
reml <-
  vlm_fit(
      fixed    = Pcv ~ Drug + dose + Drug:dose
    , data     = ex125
    , random   = ~ Region + Region:Drug
    , repeated = NULL
    , method   = "REML"
    , ddfm     = "default"
    , type     = 3
    , class    = NULL
    , bound    = TRUE
    , control  = list()
    )
mom <-
  vlm_fit(
      fixed    = Pcv ~ Drug + dose + Drug:dose
    , data     = ex125
    , random   = ~ Region + Region:Drug
    , repeated = NULL
    , method   = "Type3"
    , ddfm     = "default"
    , type     = 3
    , class    = NULL
    , bound    = TRUE
    , control  = list()
    )
cbind(ML = ml$covariance$estimate, REML = reml$covariance$estimate, Type3 = mom$covariance$estimate)

# the same model with lme4 (optional)
if (requireNamespace("lme4", quietly = TRUE)) {
  lm4 <-
    lme4::lmer(
        formula = Pcv ~ Drug * dose + (1 | Region / Drug)
      , data    = ex125
      , REML    = TRUE
      )
  print(lme4::VarCorr(lm4), comp = "Variance")
}
}
