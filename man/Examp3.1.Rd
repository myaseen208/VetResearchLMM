\title{Example 3.1: a designed experiment with doses nested in drug and a covariate}
\description{
Berenil at two doses and Samorin at one dose, given to animals in herds nested in drug (\code{\link{ex31}}).
Model 1 compares the three treatments; Model 2 adds the PCV at treatment as a covariate with a common slope;
Model 3 allows a slope per treatment and compares the treatments at PCV1 = 18. The book prints only part of the
data, so the numbers differ from those of the book.
}
\examples{
# SAS program of the book (Appendix B):
#   proc mixed data=ex31;
#     class drug dose herd;
#     model PCV2 = drug dose(drug) / solution ddfm=satterth;
#     random herd(drug);
#     estimate 'Mean Samorin' intercept 1 drug 0 1 dose(drug) 0 0 1;
#     estimate 'Berenil 2 doses' dose(drug) 1 -1 0;
#     estimate 'Ber vs Sam at dose 1' drug 1 -1 dose(drug) 1 0 -1;
#     contrast 'some difference' drug 1 -1 dose(drug) 0.5 0.5 -1, drug 0 0 dose(drug) 1 -1 0;
#     lsmeans dose(drug);
#   run;
#   * Model 3: model PCV2 = drug dose(drug) PCV1*dose(drug); lsmeans dose(drug) / at PCV1=18;

m1 <-
  vlm_fit(
      fixed    = PCV2 ~ drug + drug:dose
    , data     = ex31
    , random   = ~ drug:herd
    , repeated = NULL
    , method   = "REML"
    , ddfm     = "satterth"
    , type     = 3
    , class    = c("herd", "dose")
    , bound    = TRUE
    , control  = list()
    )
m1$tests
vlm_estimate(
    fit    = m1
  , L      = list(
          "Mean Samorin"         = list(Intercept = 1, drug = c(0, 1), "drug:dose" = c(0, 0, 1))
        , "Berenil 2 doses"      = list("drug:dose" = c(1, -1, 0))
        , "Ber vs Sam at dose 1" = list(drug = c(1, -1), "drug:dose" = c(1, 0, -1))
        )
  , random = NULL
  , level  = 0.95
  )
vlm_contrast(
    fit = m1
  , L   = list(
          "some difference" = list(
              list(drug = c(1, -1), "drug:dose" = c(0.5, 0.5, -1))
            , list("drug:dose" = c(1, -1, 0))
            )
        )
  )
vlm_lsmeans(
    fit    = m1
  , specs  = ~ drug:dose
  , at     = NULL
  , diff   = FALSE
  , adjust = "none"
  , level  = 0.95
  )
m2 <-
  vlm_fit(
      fixed    = PCV2 ~ PCV1 + drug + drug:dose
    , data     = ex31
    , random   = ~ drug:herd
    , repeated = NULL
    , method   = "REML"
    , ddfm     = "satterth"
    , type     = 3
    , class    = c("herd", "dose")
    , bound    = TRUE
    , control  = list()
    )
m2$fixed
m3 <-
  vlm_fit(
      fixed    = PCV2 ~ drug + drug:dose + PCV1:drug:dose
    , data     = ex31
    , random   = ~ drug:herd
    , repeated = NULL
    , method   = "REML"
    , ddfm     = "satterth"
    , type     = 3
    , class    = c("herd", "dose")
    , bound    = TRUE
    , control  = list()
    )
vlm_lsmeans(
    fit    = m3
  , specs  = ~ drug:dose
  , at     = list(PCV1 = 18)
  , diff   = FALSE
  , adjust = "none"
  , level  = 0.95
  )
}
