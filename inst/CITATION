      , person("Luc", "Duchateau")
      , person("Paul", "Janssen")
      , person("John", "Rowlands")
      )
  , year        = year
  , note        = note
  , url         = "https://CRAN.R-project.org/package=VetResearchLMM"
  , textVersion = sprintf(paste("Yaseen, M., Duchateau, L., Janssen, P. and Rowlands, J. (%s). VetResearchLMM: Linear Mixed Models: An Introduction with Applications in Veterinary Research. %s.",
                                "https://CRAN.R-project.org/package=VetResearchLMM"), year, note)
  )
