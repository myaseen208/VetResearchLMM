# The version and year follow the installed package (from DESCRIPTION).
ver  <- if (!is.null(meta$Version)) meta$Version else utils::packageVersion("VetResearchLMM")
date <- if (!is.null(meta$Date)) meta$Date else if (!is.null(meta$`Date/Publication`)) meta$`Date/Publication` else
  as.character(Sys.Date())
year <- substr(date, 1L, 4L)
note <- sprintf("R package version %s", ver)
bibentry(
    bibtype     = "Manual"
  , key         = "VetResearchLMM"
